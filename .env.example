# Site Configuration
SITE_URL=http://localhost:4321
WORKER_URL=https://your-meme-api.workers.dev
CDN_URL=https://your-cdn.example.com

# Discord OAuth (from Discord Developer Portal > OAuth2)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Discord Server Configuration
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_KOFI_ROLE_ID=your_kofi_member_role_id

# Discord Bot (from Discord Developer Portal > Bot)
# Required for comment approval system
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_PUBLIC_KEY=your_discord_app_public_key
DISCORD_APPROVAL_CHANNEL_ID=your_approval_channel_id

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_secure_random_string

# Mux Video Configuration
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_KEY_PRIVATE=your_mux_signing_key_private_key

# Ko-fi Configuration
KOFI_USERNAME=coomerorg
KOFI_VERIFICATION_TOKEN=your_kofi_webhook_verification_token

# Cloudflare D1 (for local drizzle-kit migrations)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
