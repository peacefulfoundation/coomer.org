---
import Card from '@/components/ui/card.astro';
import CardContent from '@/components/ui/card-content.astro';
import Avatar from '@/components/ui/avatar.astro';
import { MessageSquare } from '@lucide/astro';
import { createDb } from '@/lib/db';
import { calculateCommentOpacity } from '@/lib/services/donations';

interface Props {
  postId: string;
}

const { postId } = Astro.props;
const env = Astro.locals.runtime.env;
const db = createDb(env.DB);

const comments = await db
  .selectFrom('comment')
  .innerJoin('donation', 'comment.donation_id', 'donation.id')
  .innerJoin('user', 'comment.user_id', 'user.id')
  .select([
    'comment.id',
    'comment.content',
    'comment.created_at',
    'donation.amount',
    'donation.currency',
    'donation.visible_until',
    'user.name',
    'user.discord_username',
    'user.image',
  ])
  .where('comment.post_id', '=', postId)
  .where('comment.status', '=', 'approved')
  .where('donation.visible_until', '>', Date.now())
  .orderBy('donation.amount', 'desc')
  .orderBy('comment.created_at', 'desc')
  .execute();

function formatTimeRemaining(visibleUntil: number): string {
  const remaining = visibleUntil - Date.now();
  const days = Math.ceil(remaining / (1000 * 60 * 60 * 24));
  if (days > 30) return `${Math.floor(days / 30)}mo left`;
  if (days > 7) return `${Math.floor(days / 7)}w left`;
  return `${days}d left`;
}
---

{comments.length > 0 && (
  <div class="mt-4 space-y-3 px-4 pb-4">
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <MessageSquare class="h-4 w-4" />
      <span>{comments.length} comment{comments.length !== 1 ? 's' : ''}</span>
    </div>
    
    {comments.map((comment) => {
      const opacity = calculateCommentOpacity(
        new Date(comment.visible_until),
        new Date(comment.created_at)
      );
      return (
        <Card class="overflow-hidden" style={`opacity: ${opacity}`}>
          <CardContent class="p-3">
            <div class="flex items-start gap-3">
              <Avatar
                src={comment.image}
                alt={comment.discord_username || comment.name}
                class="h-8 w-8 flex-shrink-0"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-medium truncate">
                    {comment.discord_username || comment.name}
                  </span>
                  <div class="flex items-center gap-2 text-xs text-muted-foreground flex-shrink-0">
                    <span class="font-medium text-pink-500">${comment.amount}</span>
                    <span>•</span>
                    <span>{formatTimeRemaining(comment.visible_until)}</span>
                  </div>
                </div>
                <p class="mt-1 text-sm break-words">{comment.content}</p>
              </div>
            </div>
          </CardContent>
        </Card>
      );
    })}
  </div>
)}
