---
import Button from '@/components/ui/button.astro';
import PostList from '@/components/PostList.astro';
import VideoList from '@/components/VideoList.astro';
import { Image, Video, Lock } from '@lucide/astro';

interface Props {
  isLoggedIn: boolean;
  isKofiMember: boolean;
  workerUrl: string;
  kofiUsername?: string;
}

const { isLoggedIn, isKofiMember, workerUrl, kofiUsername = 'coomerorg' } = Astro.props;
const canAccessVideos = isLoggedIn && isKofiMember;
---

<div class="space-y-6">
  <h1 class="text-2xl font-bold">begin the scrooooooling!!!</h1>
  
  <div class="flex flex-grow space-x-3" id="tab-buttons">
    <Button variant="default" class="tab-btn" data-tab="images">
      <Image class="mr-2 h-4 w-4" />
      memes
    </Button>
    
    <Button 
      variant="secondary" 
      class="tab-btn" 
      data-tab="videos"
      showLock={!canAccessVideos}
      disabled={isLoggedIn && !isKofiMember}
    >
      <Video class="mr-2 h-4 w-4" />
      video memes
      {!isLoggedIn && <span class="ml-1 text-xs">(login)</span>}
      {isLoggedIn && !isKofiMember && <span class="ml-1 text-xs">(ko-fi)</span>}
    </Button>
  </div>

  <div id="tab-images" class="tab-content">
    <PostList workerUrl={workerUrl} isLoggedIn={isLoggedIn} kofiUsername={kofiUsername} />
  </div>
  
  <div id="tab-videos" class="tab-content hidden">
    {canAccessVideos ? (
      <VideoList />
    ) : isLoggedIn ? (
      <div class="flex flex-col items-center justify-center space-y-4 py-12 text-center">
        <Lock class="h-12 w-12 text-muted-foreground" />
        <h2 class="text-xl font-semibold">Ko-fi Members Only</h2>
        <p class="max-w-md text-muted-foreground">
          Video memes are exclusive to our monthly Ko-fi supporters.
        </p>
        <a
          href={`https://ko-fi.com/${kofiUsername}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full border-[1.5px] border-black bg-black px-6 py-2.5 font-semibold text-white transition-colors hover:bg-white hover:text-black"
        >
          Support on Ko-fi
        </a>
        <p class="text-sm text-muted-foreground">
          Already a member? <a href="/profile" class="underline">Refresh your status</a>
        </p>
      </div>
    ) : null}
  </div>
</div>

<script define:vars={{ isLoggedIn, canAccessVideos }}>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.tab-btn');
    const imagesTab = document.getElementById('tab-images');
    const videosTab = document.getElementById('tab-videos');

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tab = btn.getAttribute('data-tab');
        
        if (tab === 'videos' && !isLoggedIn) {
          window.location.href = '/api/auth/signin/discord?callbackUrl=' + encodeURIComponent(window.location.href);
          return;
        }

        if (tab === 'videos' && !canAccessVideos) {
          return;
        }

        buttons.forEach(b => {
          const isActive = b.getAttribute('data-tab') === tab;
          b.classList.toggle('bg-black', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('bg-transparent', !isActive);
        });

        imagesTab?.classList.toggle('hidden', tab !== 'images');
        videosTab?.classList.toggle('hidden', tab !== 'videos');
      });
    });
  });
</script>
