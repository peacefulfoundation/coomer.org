---
import Card from '@/components/ui/card.astro';
import CardContent from '@/components/ui/card-content.astro';
import Button from '@/components/ui/button.astro';
import CommentSection from '@/components/CommentSection.astro';
import { Share2, Heart } from '@lucide/astro';

interface Props {
  id: string;
  imageUrl: string;
  isLoggedIn?: boolean;
  kofiUsername?: string;
  showComments?: boolean;
}

const { id, imageUrl, isLoggedIn = false, kofiUsername = 'coomerorg', showComments = true } = Astro.props;
---

<Card class="overflow-hidden">
  <CardContent class="p-0">
    <div class="relative w-full">
      <img src={imageUrl} alt={id} class="h-auto w-full" loading="lazy" />
    </div>
    <div class="flex items-center justify-between px-4 py-2">
      <p class="ml-1 text-left text-sm font-medium text-muted-foreground">{id}</p>
      <div class="flex items-center gap-2">
        <Button
          variant="secondary"
          size="sm"
          showLock={!isLoggedIn}
          class="donate-btn gap-1"
          data-post-id={id}
          data-logged-in={isLoggedIn}
          data-kofi={kofiUsername}
        >
          <Heart class="h-4 w-4 text-pink-500" />
          Donate
          {!isLoggedIn && <span class="text-xs ml-1">(login)</span>}
        </Button>
        <Button
          variant="ghost"
          size="icon"
          class="download-btn rounded-full text-muted-foreground"
          data-url={imageUrl}
          data-filename={`${id}.jpg`}
        >
          <Share2 class="h-4 w-4" />
        </Button>
      </div>
    </div>
    {showComments && <CommentSection postId={id} />}
  </CardContent>
</Card>

<script>
  document.addEventListener('astro:page-load', () => {
    // Download handler
    document.querySelectorAll('.download-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url');
        const filename = btn.getAttribute('data-filename');
        if (!url || !filename) return;

        try {
          const response = await fetch(`/api/download?imageUrl=${encodeURIComponent(url)}&filename=${encodeURIComponent(filename)}`);
          if (!response.ok) throw new Error('Download failed');
          
          const blob = await response.blob();
          const blobUrl = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = blobUrl;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(blobUrl);
        } catch (e) {
          console.error(e);
        }
      });
    });

    // Donate handler
    document.querySelectorAll('.donate-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const postId = btn.getAttribute('data-post-id');
        const isLoggedIn = btn.getAttribute('data-logged-in') === 'true';
        const kofi = btn.getAttribute('data-kofi');

        if (!isLoggedIn) {
          window.location.href = '/api/auth/signin/discord?callbackUrl=' + encodeURIComponent(window.location.href);
          return;
        }

        try {
          const response = await fetch('/api/donate/intent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ postId }),
          });

          if (!response.ok) {
            const error = await response.json();
            alert(error.error || 'Failed to start donation');
            return;
          }

          const { intentId } = await response.json();
          localStorage.setItem('pendingDonationIntent', JSON.stringify({ intentId, postId, timestamp: Date.now() }));
          window.open(`https://ko-fi.com/${kofi}`, '_blank');
          alert('Ko-fi opened! After donating, visit /donate/complete to leave your comment.');
        } catch (e) {
          console.error(e);
          alert('Something went wrong');
        }
      });
    });
  });
</script>
