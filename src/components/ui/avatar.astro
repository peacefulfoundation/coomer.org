---
import { cn } from '@/lib/utils';

interface Props {
  src?: string | null;
  alt?: string;
  fallback?: string;
  class?: string;
}

const { src, alt = '', fallback, class: className } = Astro.props;
const fallbackText = fallback || alt?.charAt(0)?.toUpperCase() || '?';
---

<div class={cn('relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full', className)}>
  {src ? (
    <img src={src} alt={alt} class="aspect-square h-full w-full object-cover" />
  ) : (
    <div class="flex h-full w-full items-center justify-center bg-muted text-sm font-medium">
      {fallbackText}
    </div>
  )}
</div>
