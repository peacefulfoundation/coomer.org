---
import { tv, type VariantProps } from 'tailwind-variants';
import { cn } from '@/lib/utils';
import { Lock } from '@lucide/astro';

const buttonVariants = tv({
  base: 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50',
  variants: {
    variant: {
      default: 'w-fit rounded-full border-[1.5px] border-black bg-black font-semibold text-white hover:bg-white hover:text-black',
      secondary: 'w-fit rounded-full border-[1.5px] border-black font-semibold hover:bg-black hover:text-white',
      outline: 'border border-input bg-background hover:bg-accent hover:text-accent-foreground',
      ghost: 'hover:bg-accent hover:text-accent-foreground',
      link: 'text-primary underline-offset-4 hover:underline',
      destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
    },
    size: {
      default: 'px-4 py-2.5',
      sm: 'px-4 py-1.5 text-sm',
      lg: 'h-11 px-8',
      icon: 'h-10 w-10',
    },
  },
  defaultVariants: {
    variant: 'default',
    size: 'default',
  },
});

type ButtonVariants = VariantProps<typeof buttonVariants>;

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?: ButtonVariants['variant'];
  size?: ButtonVariants['size'];
  href?: string;
  showLock?: boolean;
}

const { variant, size, class: className, href, showLock, disabled, ...props } = Astro.props;
const Component = href ? 'a' : 'button';
---

<div class="relative inline-flex">
  <Component
    class={cn(buttonVariants({ variant, size }), className)}
    href={href}
    disabled={disabled}
    {...props}
  >
    <slot />
  </Component>
  {showLock && (
    <span class="absolute -right-1.5 -top-1.5 flex items-center justify-center rounded-full bg-background p-1">
      <Lock class="size-4 text-muted-foreground" />
    </span>
  )}
</div>
