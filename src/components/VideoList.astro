---
import Card from '@/components/ui/card.astro';
import CardContent from '@/components/ui/card-content.astro';
import Skeleton from '@/components/ui/skeleton.astro';
import { PlayCircle } from '@lucide/astro';
---

<div class="space-y-4" id="video-list">
  <div id="videos-container" class="space-y-4"></div>
  
  <div id="video-loading" class="space-y-4">
    {[1, 2, 3].map(() => (
      <Card>
        <CardContent class="p-0">
          <Skeleton class="aspect-video w-full" />
          <div class="flex justify-center">
            <Skeleton class="my-4 h-4 w-2/3" />
          </div>
        </CardContent>
      </Card>
    ))}
  </div>
  
  <p id="video-error" class="hidden text-center text-muted-foreground"></p>
  <div id="video-trigger" class="h-10"></div>
  <p id="video-end" class="hidden text-center text-muted-foreground">
    That's all the video memes for now!
  </p>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('video-list');
    if (!container) return;

    const videosContainer = document.getElementById('videos-container');
    const loadingIndicator = document.getElementById('video-loading');
    const errorMessage = document.getElementById('video-error');
    const loadTrigger = document.getElementById('video-trigger');
    const endMessage = document.getElementById('video-end');

    let cursor: string | null = null;
    let loading = false;
    let hasMore = true;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && hasMore && !loading) {
          loadMore();
        }
      },
      { threshold: 0.1 }
    );

    if (loadTrigger) observer.observe(loadTrigger);

    async function loadMore() {
      if (!hasMore || loading) return;
      loading = true;
      errorMessage?.classList.add('hidden');

      try {
        const url = new URL('/api/videos', window.location.origin);
        url.searchParams.append('limit', '6');
        if (cursor) url.searchParams.append('cursor', cursor);

        const response = await fetch(url.toString(), { credentials: 'include' });
        
        if (!response.ok) {
          const data = await response.json();
          throw new Error(data.error || 'Failed to fetch');
        }

        const data = await response.json();
        cursor = data.cursor;
        hasMore = !!cursor;

        loadingIndicator?.classList.add('hidden');

        data.videos.forEach((video: { id: string; title: string; thumbnailUrl: string; signedUrl: string; duration: number }) => {
          const mins = Math.floor(video.duration / 60);
          const secs = Math.floor(video.duration % 60);
          const duration = `${mins}:${secs.toString().padStart(2, '0')}`;

          const article = document.createElement('article');
          article.className = 'video-card';
          article.innerHTML = `
            <div class="rounded-lg border bg-card shadow-sm overflow-hidden">
              <div class="relative aspect-video w-full cursor-pointer video-thumbnail" data-url="${video.signedUrl}">
                <img src="${video.thumbnailUrl}" alt="${video.title}" class="h-full w-full object-cover" loading="lazy" />
                <div class="absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/40 transition-opacity">
                  <svg class="h-16 w-16 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                </div>
                <div class="absolute bottom-2 right-2 rounded bg-black/70 px-2 py-1 text-xs text-white">${duration}</div>
              </div>
              <div class="video-player hidden aspect-video w-full">
                <video src="${video.signedUrl}" controls class="h-full w-full" playsinline></video>
              </div>
              <div class="flex items-center justify-between px-4 py-2">
                <p class="text-sm font-medium text-muted-foreground">${video.title}</p>
              </div>
            </div>
          `;
          videosContainer?.appendChild(article);

          const thumbnail = article.querySelector('.video-thumbnail');
          const player = article.querySelector('.video-player');
          const videoEl = article.querySelector('video');

          thumbnail?.addEventListener('click', () => {
            thumbnail.classList.add('hidden');
            player?.classList.remove('hidden');
            videoEl?.play();
          });
        });

        if (!hasMore && data.videos.length > 0) {
          loadTrigger?.classList.add('hidden');
          endMessage?.classList.remove('hidden');
          observer.disconnect();
        }
      } catch (e: any) {
        loadingIndicator?.classList.add('hidden');
        if (errorMessage) {
          errorMessage.textContent = e.message || 'Failed to load videos';
          errorMessage.classList.remove('hidden');
        }
        hasMore = false;
      } finally {
        loading = false;
      }
    }
  });
</script>
