---
import '@/styles/globals.css';
import { AuthButton } from '@/components/AuthButton';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'curated coomer memes' } = Astro.props;

const siteConfig = {
  url: 'https://www.coomer.org',
  title: 'coomer.org',
  author: 'anon',
};

const user = Astro.locals.user;
const isLoggedIn = !!user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="generator" content={Astro.generator} />
    
    <meta property="og:url" content={siteConfig.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon.png" />
    
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="/favicon.png" />
    
    <meta name="theme-color" content="#576d00" />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    
    <title>{title} - {siteConfig.title}</title>
  </head>
  <body class="relative flex min-h-screen flex-col bg-background font-sans antialiased">
    <header class="flex h-20 w-full items-center justify-between px-4 md:container">
      <img
        src="/favicon.png"
        height="32"
        width="32"
        alt={siteConfig.title}
        class="block rounded-full md:hidden"
      />
      <a
        href="/"
        class="hidden p-2 text-2xl font-bold transition-colors duration-200 hover:text-foreground/80 md:block"
      >
        {siteConfig.title}
      </a>
      <div class="flex items-center space-x-2 font-semibold">
        <a
          class="p-2 underline-offset-4 hover:underline"
          href="/ethos"
        >
          ethos
        </a>
        <a href="https://discord.com/invite/pFvDZms3AY">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 127.14 96.36"
            class="size-8 transition-transform duration-200 hover:scale-110 md:ml-2"
          >
            <path
              fill="#5865f2"
              d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"
            />
          </svg>
        </a>
        <div class="ml-4">
          <AuthButton 
            client:load 
            isLoggedIn={isLoggedIn}
            user={user ? {
              name: user.name,
              image: user.image,
              discordUsername: user.discordUsername,
            } : null}
          />
        </div>
      </div>
    </header>
    
    <div class="mx-4 flex-1 py-8 md:container md:mx-auto md:py-0">
      <slot />
    </div>
    
    <footer class="mt-auto flex h-20 items-center justify-between px-4 py-4 md:container md:mx-auto">
      <div class="flex items-center space-x-2 font-semibold">
        <!-- Left footer links -->
      </div>
      <div class="flex items-center space-x-4 font-semibold">
        <a
          class="underline-offset-4 hover:underline"
          href="https://quiteasily.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          quiteasily
        </a>
        <a
          class="underline-offset-4 hover:underline"
          href="https://easypeasy.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          easypeasy
        </a>
      </div>
    </footer>
  </body>
</html>
