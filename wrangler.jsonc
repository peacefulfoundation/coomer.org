{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "coomer-org",

  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // D1 Databases
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coomer-db",
      "database_id": "c680fc4f-2d7a-46c6-9376-3774879a0c2a"
    }
  ],

  // R2 Buckets
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "coomer"
    }
  ],

  // KV Namespaces
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b73014cc5992456d88d8ba88a8a6123a"
    }
  ],

  // Public Environment Variables
  "vars": {
    "SITE_URL": "https://coomer.org",
    "DISCORD_GUILD_ID": "YOUR_DISCORD_GUILD_ID",
    "DISCORD_KOFI_ROLE_ID": "YOUR_KOFI_ROLE_ID",
    "DISCORD_APPROVAL_CHANNEL_ID": "YOUR_APPROVAL_CHANNEL_ID",
    "KOFI_USERNAME": "peacefulfoundation"
  },

  // Secrets (set via: pnpm wrangler secret put <NAME>)
  // - DISCORD_CLIENT_ID
  // - DISCORD_CLIENT_SECRET
  // - BETTER_AUTH_SECRET
  // - MUX_TOKEN_ID
  // - MUX_TOKEN_SECRET
  // - MUX_SIGNING_KEY_ID
  // - MUX_SIGNING_KEY_PRIVATE
  // - DISCORD_BOT_TOKEN
  // - DISCORD_PUBLIC_KEY
  // - KOFI_VERIFICATION_TOKEN

  "observability": {
    "enabled": true
  }
}
